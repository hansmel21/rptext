; Engine configuration file.
; Edit via Godot editor UI — do not edit manually unless you know what you're doing.
config_version=5

[application]

config/name="Project Scout"
config/description="Chapter 1: The Night of Ash"
run/main_scene="res://scenes/menus/BuildSelection.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")

[autoload]

GameManager="*res://scripts/autoloads/GameManager.gd"
QuestManager="*res://scripts/autoloads/QuestManager.gd"
AudioManager="*res://scripts/autoloads/AudioManager.gd"
HungerSystem="*res://scripts/autoloads/HungerSystem.gd"
PetCommandSystem="*res://scripts/autoloads/PetCommandSystem.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/initial_position_type=2
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

